{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@richespay/shared": ["packages/shared/src/index.ts"],
      "@richespay/ui": ["packages/ui/src/index.ts"]
    }
  }
}
